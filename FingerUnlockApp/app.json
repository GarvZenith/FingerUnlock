{
  "expo": {
    "name": "FingerUnlock",
    "slug": "fingerprint",
    "scheme": "fingerunlock",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.garv.fingerunlock",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK",
        "DISABLE_KEYGUARD",
        "VIBRATE",
        "FOREGROUND_SERVICE"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-local-authentication",
      "expo-notifications",
      "@react-native-firebase/app",
      "./plugins/withLockScreen",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "eas": {
        "projectId": "484d0eaa-5ea4-41f1-a361-0dbe33067fc4"
      }
    }
  }
}
