Windows Registry Editor Version 5.00

; Registers the FingerUnlock Credential Provider.
; The DLL must be at C:\FingerUnlock\FingerUnlockCP.dll (see install steps).
; CLSID = {2B5B8F1A-9C3D-4E7A-B12C-3D4E5F607182}

[HKEY_CLASSES_ROOT\CLSID\{2B5B8F1A-9C3D-4E7A-B12C-3D4E5F607182}]
@="FingerUnlock Credential Provider"

[HKEY_CLASSES_ROOT\CLSID\{2B5B8F1A-9C3D-4E7A-B12C-3D4E5F607182}\InprocServer32]
@="C:\\FingerUnlock\\FingerUnlockCP.dll"
"ThreadingModel"="Apartment"

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{2B5B8F1A-9C3D-4E7A-B12C-3D4E5F607182}]
@="FingerUnlock Credential Provider"
