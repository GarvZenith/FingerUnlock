<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FingerUnlockSvc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SessionSwitch (console/dev lock detection) -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <!-- ServiceBase + WTS session-change events (boot-SYSTEM service, cold boot) -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- DPAPI (ProtectedData) for the PC private key + cred handoff (Stage 2 ECDH) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- FCM v1 data messages for the native full-screen "call" prompt (Step B) -->
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />
  </ItemGroup>

</Project>
